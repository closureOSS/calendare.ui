{
  "name": "calendare-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --serve-path /admin/ --ssl --ssl-key localhost.key --ssl-cert localhost",
    "build": "ng build --configuration production && npm run i18n:optimize",
    "build:admin": "ng build admin --configuration production && npm run i18n:optimize",
    "api:generate": "ng-openapi -c openapi.config.ts",
    "i18n:extract": "transloco-keys-manager extract --project admin --output projects/admin/public/i18n",
    "i18n:find": "transloco-keys-manager find --project admin --output projects/admin/public/i18n",
    "i18n:optimize": "transloco-optimize dist/admin/browser/i18n",
    "icon:admin": "MaterialSymbolPacker.exe generate --config ./projects/admin/icon.config.json",
    "watch": "ng build --watch",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@jsverse/transloco": "^8.1.0",
    "@ng-icons/core": ">=35.0.0 <36.0.0",
    "@ng-icons/lucide": ">=35.0.0 <36.0.0",
    "@ng-icons/material-symbols": ">=35.0.0 <36.0.0",
    "@spartan-ng/brain": "^1.3.2",
    "@tailwindcss/postcss": "^4.3.2",
    "angular-auth-oidc-client": "^22.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "postcss": "^8.5.16",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.2",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-keys-manager": "^8.0.0",
    "@jsverse/transloco-optimize": "^8.1.0",
    "@ng-openapi/http-resource": "^0.1.0",
    "@spartan-ng/cli": "^1.3.2",
    "angular-eslint": "22.1.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "ng-openapi": "^0.3.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "less@4.5.1": true,
    "esbuild": true,
    "@parcel/watcher": true,
    "lmdb": true,
    "nx": true
  }
}
