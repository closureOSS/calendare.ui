{
  "name": "calendare-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --serve-path /admin/ --ssl --ssl-key localhost.key --ssl-cert localhost",
    "build": "ng build --configuration production && npm run i18n:optimize",
    "build:admin": "ng build admin --configuration production && npm run i18n:optimize",
    "api:generate": "ng-openapi -c openapi.config.ts",
    "i18n:extract": "transloco-keys-manager extract --project admin --output projects/admin/public/i18n",
    "i18n:find": "transloco-keys-manager find --project admin --output projects/admin/public/i18n",
    "i18n:optimize": "transloco-optimize dist/admin/browser/i18n",
    "icon:admin": "MaterialSymbolPacker.exe generate --config ./projects/admin/icon.config.json",
    "watch": "ng build --watch",
    "test": "ng test",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.5",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/material": "^22.0.5",
    "@angular/material-date-fns-adapter": "^22.0.5",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@jsverse/transloco": "^8.1.0",
    "angular-auth-oidc-client": "^21.0.0",
    "date-fns": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@jsverse/transloco-keys-manager": "^8.0.0",
    "@jsverse/transloco-optimize": "^8.1.0",
    "@ng-openapi/http-resource": "^0.1.0",
    "@types/jasmine": "~6.0.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.0.0",
    "@eslint/js": "^10.0.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-openapi": "^0.3.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "@parcel/watcher@2.5.6": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
